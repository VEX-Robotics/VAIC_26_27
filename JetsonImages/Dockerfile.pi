# Raspberry Pi 5 — VEX AI rootfs builder
#
# Produces a root filesystem tarball for assembly into a Pi .img by build-img-pi.sh.
#
# Build and export (normally invoked by build-img-pi.sh):
#   docker build --platform linux/arm64 -t vexai-pi -f Dockerfile.pi \
#       --output type=tar,dest=pi-rootfs.tar .

FROM raspios-base:latest
LABEL maintainer="VEX Robotics"

ENV DEBIAN_FRONTEND=noninteractive

# Fail fast if not building for arm64/aarch64.
RUN test "$(dpkg --print-architecture)" = "arm64"

# ── System update ─────────────────────────────────────────────────────────────
RUN apt-get update && apt-get -y upgrade && apt-get clean

# ── Base tools ────────────────────────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends \
        curl ca-certificates git sudo gnupg lsb-release \
        libusb-1.0-0 libxcb1 libgl1-mesa-dev kmod \
    && apt-get clean

# ── User account ──────────────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash vex \
    && echo 'vex:password' | chpasswd \
    && usermod -aG sudo,dialout,video,audio vex \
    && echo 'vex ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vex

# ── Pyenv build dependencies ──────────────────────────────────────────────────
# Pi OS ships Python 3.11; PyCoral only supports Python ≤3.9.
# Pyenv compiles Python 3.9.22 from source — these packages are required.
RUN apt-get install -y --no-install-recommends \
        make build-essential libssl-dev zlib1g-dev libbz2-dev \
        libreadline-dev libsqlite3-dev wget llvm \
        libncurses5-dev libncursesw5-dev xz-utils \
        tk-dev libffi-dev liblzma-dev \
    && apt-get clean

# ── Pyenv + Python 3.9.22 ─────────────────────────────────────────────────────
# Installed as the vex user. su -l resets environment, so PYENV_ROOT and PATH
# must be set explicitly inside the subshell.
# NOTE: This layer takes ~15 minutes on a Pi 5 (compiles Python from source).
RUN su -l vex -c \
    'export PYENV_ROOT=/home/vex/.pyenv \
     && export PATH=$PYENV_ROOT/bin:$PATH \
     && curl https://pyenv.run | bash \
     && pyenv install 3.9.22 \
     && pyenv global 3.9.22'

# Wire pyenv into login and interactive shells for the vex user.
RUN printf 'export PYENV_ROOT="$HOME/.pyenv"\n[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"\neval "$(pyenv init - bash)"\n' \
    | tee -a /home/vex/.bash_profile >> /home/vex/.bashrc \
    && chown vex:vex /home/vex/.bash_profile /home/vex/.bashrc

# ── Intel RealSense (build from source, RSUSB backend) ───────────────────────
# Intel APT repo has no Debian releases (Ubuntu only); no ARM64 pip wheel.
# Build against pyenv Python 3.9 so pyrealsense2 is importable from the vex env.
# Takes ~15 min on a Pi 5 (compiles librealsense2 from source).
RUN apt-get install -y --no-install-recommends \
        cmake ninja-build libssl-dev libusb-1.0-0-dev pkg-config \
        libgtk-3-dev libglfw3-dev libgl1-mesa-dev libglu1-mesa-dev \
    && apt-get clean

RUN git clone --depth=1 --branch v2.57.7 https://github.com/IntelRealSense/librealsense.git /opt/librealsense \
    && mkdir -p /etc/udev/rules.d \
    && cp /opt/librealsense/config/99-realsense-libusb.rules /etc/udev/rules.d/ \
    && mkdir /opt/librealsense/build \
    && cmake -S /opt/librealsense -B /opt/librealsense/build -G Ninja \
        -DFORCE_RSUSB_BACKEND=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DBUILD_EXAMPLES=false \
        -DBUILD_GRAPHICAL_EXAMPLES=false \
        -DPYTHON_EXECUTABLE=/home/vex/.pyenv/versions/3.9.22/bin/python3 \
        -DPYTHON_INSTALL_DIR=/home/vex/.pyenv/versions/3.9.22/lib/python3.9/site-packages \
        -DPYTHON_LIBRARY=/home/vex/.pyenv/versions/3.9.22/lib/libpython3.9.so \
        -DPython_ROOT_DIR=/home/vex/.pyenv/versions/3.9.22 \
        -DCMAKE_BUILD_TYPE=release \
        -DCHECK_FOR_UPDATES=false \
    && cmake --build /opt/librealsense/build --parallel \
    && cmake --install /opt/librealsense/build  \
    && ldconfig \
    && rm -rf /opt/librealsense


# ── Google Coral Edge TPU runtime ─────────────────────────────────────────────
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | \
        gpg --dearmor | tee /etc/apt/keyrings/coral.gpg > /dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/coral.gpg] https://packages.cloud.google.com/apt coral-edgetpu-stable main" | \
        tee /etc/apt/sources.list.d/coral-edgetpu.list \
    && apt-get update \
    && apt-get install -y libedgetpu1-std \
    && apt-get clean

# ── Gasket driver for M.2 Coral accelerator ───────────────────────────────────
# Builds and installs the DKMS module at image build time using the Pi kernel
# headers from the base image — no internet or compilation needed on first boot.
RUN apt-get install -y --no-install-recommends \
        devscripts lintian dkms dh-dkms debhelper linux-headers-rpi-v8 \
    && apt-get clean

COPY --chown=vex:vex JetsonImages/fix_gasket_driver.patch /home/vex/fix_gasket_driver.patch

RUN su -l vex -c \
    'git clone https://github.com/google/gasket-driver.git ~/gasket-driver \
     && cd ~/gasket-driver \
     && git apply --ignore-whitespace ~/fix_gasket_driver.patch \
     && debuild -us -uc -tc -b'

RUN dpkg -i /home/vex/gasket-dkms_*.deb \
    && KVER=$(ls /lib/modules/ | head -1) \
    && dkms install gasket/1.0 -k "$KVER" \
    && rm -rf /home/vex/gasket-driver \
    && find /home/vex -maxdepth 1 \( -name 'gasket_*' -o -name 'gasket-dkms_*' \) -delete \
    && rm -f /home/vex/fix_gasket_driver.patch

# ── Apex udev rules and group ─────────────────────────────────────────────────
RUN echo 'SUBSYSTEM=="apex", MODE="0660", GROUP="apex"' \
        > /etc/udev/rules.d/65-apex.rules \
    && groupadd -f apex \
    && usermod -aG apex vex

# ── Dashboard dependency manifests for Docker layer caching ──────────────────
WORKDIR /home/vex
RUN mkdir -p /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react
COPY JetsonWebDashboard/vexai-web-dashboard-react/package.json \
     /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react/
COPY JetsonWebDashboard/vexai-web-dashboard-react/package-lock.json \
     /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react/

# ── Node.js 16 + web dashboard ────────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends nodejs npm && apt-get clean \
    && npm cache clean -f \
    && npm install -g n \
    && n 16 \
    && npm install -g serve

# ── Python packages ───────────────────────────────────────────────────────────
# pyrealsense2 pip wheel uses the RSUSB backend; links against librealsense2.
RUN su -l vex -c \
    'export PYENV_ROOT=/home/vex/.pyenv \
     && export PATH=$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH \
     && pip install --upgrade pip \
     && pip install pyserial websocket-server Pillow opencv-python \
     && pip install --extra-index-url https://google-coral.github.io/py-repo/ pycoral~=2.0 \
     && pip install "numpy<2.0"'

# ── Networking stack ──────────────────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends \
        network-manager wpasupplicant wireless-regdb \
        iproute2 iputils-ping net-tools rfkill dnsmasq-base \
        openssh-server udev firmware-brcm80211 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── SSH + UART console ────────────────────────────────────────────────────────
RUN mkdir -p /run/sshd \
    && ln -sf /lib/systemd/system/ssh.service \
        /etc/systemd/system/multi-user.target.wants/ssh.service \
    && mkdir -p /etc/systemd/system/getty.target.wants \
    && ln -sf /lib/systemd/system/serial-getty@.service \
        /etc/systemd/system/getty.target.wants/serial-getty@ttyAMA0.service \
    && mkdir -p /etc/systemd/system/getty@tty1.service.d

COPY JetsonExample/Services/pi/autologin.conf \
     /etc/systemd/system/getty@tty1.service.d/autologin.conf

# ── Clone VAIC repository ─────────────────────────────────────────────────────
WORKDIR /home/vex
COPY --chown=vex:vex . /home/vex/VAIC_26_27

# ── Build web dashboard ───────────────────────────────────────────────────────
WORKDIR /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react
RUN [ -d build ] || (npm install && npm run build)

RUN sed -i 's/^[^#]/#&/' /etc/locale.gen \
    && sed -i -E '/en_(US|GB)/s/^#//' /etc/locale.gen \
    && locale-gen

# ── Wi-Fi hotspot ─────────────────────────────────────────────────────────────
RUN mkdir -p /etc/NetworkManager/system-connections \
    && mkdir -p /etc/systemd/system/multi-user.target.wants \
    && ln -sf /lib/systemd/system/NetworkManager.service \
        /etc/systemd/system/multi-user.target.wants/NetworkManager.service \
    && ln -sf /lib/systemd/system/NetworkManager.service \
        /etc/systemd/system/dbus-org.freedesktop.NetworkManager.service \
    && printf '[ifupdown]\nmanaged=true\n' > /etc/NetworkManager/conf.d/10-vex-managed.conf \
    && printf '[connection]\nid=Hotspot\ntype=wifi\nautoconnect=true\n\n[wifi]\nmode=ap\nssid=VexAI\nband=bg\n\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=vexrobotics\n\n[ipv4]\nmethod=shared\n\n[ipv6]\nmethod=ignore\n' \
        > /etc/NetworkManager/system-connections/VexAI-Hotspot.nmconnection \
    && chmod 600 /etc/NetworkManager/system-connections/VexAI-Hotspot.nmconnection \
    && echo 'REGDOMAIN=US' > /etc/default/crda \
    && mkdir -p /var/lib/NetworkManager \
    && printf '[main]\nNetworkingEnabled=true\nWifiEnabled=true\nWwanEnabled=true\n' \
        > /var/lib/NetworkManager/NetworkManager.state \
    && chmod 600 /var/lib/NetworkManager/NetworkManager.state

# ── First-boot root partition resize ─────────────────────────────────────────
RUN apt-get install -y --no-install-recommends cloud-guest-utils && apt-get clean

COPY JetsonExample/Scripts/firstboot-resize.sh /usr/local/sbin/firstboot-resize.sh
COPY JetsonExample/Services/firstboot-resize.service /etc/systemd/system/firstboot-resize.service
COPY JetsonExample/Services/pi/gasket-load.service      /etc/systemd/system/gasket-load.service
COPY JetsonExample/Services/pi/vexai.service            /etc/systemd/system/vexai.service
RUN chmod +x /usr/local/sbin/firstboot-resize.sh \
    && chmod +x /home/vex/VAIC_26_27/JetsonExample/Scripts/run.sh \
    && chmod +x /home/vex/VAIC_26_27/JetsonExample/Scripts/service.sh \
    && ln -sf /etc/systemd/system/firstboot-resize.service \
        /etc/systemd/system/multi-user.target.wants/firstboot-resize.service \
    && ln -sf /etc/systemd/system/gasket-load.service \
        /etc/systemd/system/multi-user.target.wants/gasket-load.service \
    && ln -sf /etc/systemd/system/vexai.service \
        /etc/systemd/system/multi-user.target.wants/vexai.service
