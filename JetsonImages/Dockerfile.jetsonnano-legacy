# Legacy Jetson Nano (JetPack 4.6 / L4T 32.x) rootfs builder
#
# Build and export:
#   docker build --platform linux/arm64 -t vexai-nano-rootfs -f Dockerfile.jetsonnano-legacy .
#   docker create --name vexai-nano-rootfs vexai-nano-rootfs
#   docker export vexai-nano-rootfs | gzip > vexai-nano-rootfs.tar.gz
#   docker rm vexai-nano-rootfs

FROM nvcr.io/nvidia/l4t-base:r32.7.1
LABEL maintainer="VEX Robotics"

ENV DEBIAN_FRONTEND=noninteractive

# Fail fast if the image is not building for arm64/aarch64.
RUN test "$(dpkg --print-architecture)" = "arm64"

# Base tools for JetPack 4-era Ubuntu userspace.
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        python3-opencv \
        curl ca-certificates git sudo lsb-release gnupg \
        libusb-1.0-0 libxcb1 libgl1-mesa-dev \
        network-manager \
    && apt-get clean 

# User account
RUN useradd -m -s /bin/bash vex \
    && echo 'vex:password' | chpasswd \
    && usermod -aG sudo,dialout,video,audio vex \
    && echo 'vex ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vex

ENV VENV="/opt/vexai"
ENV PATH="$VENV/bin:/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

RUN apt-get install -y --no-install-recommends \
        cmake ninja-build build-essential libssl-dev libusb-1.0-0-dev pkg-config \
        libgtk-3-dev libglfw3-dev libgl1-mesa-dev libglu1-mesa-dev \
    && apt-get clean
    
RUN python3 -m venv --system-site-packages $VENV

RUN git clone --depth=1 --branch v2.55.1 https://github.com/IntelRealSense/librealsense.git /opt/librealsense \
    && mkdir -p /etc/udev/rules.d \
    && cp /opt/librealsense/config/99-realsense-libusb.rules /etc/udev/rules.d/ \
    && mkdir /opt/librealsense/build \
    && cd /opt/librealsense/build \
    && cmake .. -G Ninja \
        -DFORCE_RSUSB_BACKEND=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_GRAPHICAL_EXAMPLES=OFF \
        -DPYTHON_EXECUTABLE="${VENV}/bin/python3" \
        -DPYTHON_INSTALL_DIR="${VENV}/lib/python3.6/site-packages" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCHECK_FOR_UPDATES=OFF \
        -DBUILD_WITH_CUDA=ON \
    && cmake --build . -- -j"$(nproc)" \
    && cmake --build . --target install

RUN mkdir -p "${VENV}/lib/python3.6/site-packages/pyrealsense2" \
    && find /opt/librealsense/build -name "pyrealsense2.cpython*.so*" \
        -exec cp {} "${VENV}/lib/python3.6/site-packages/pyrealsense2/" \; \
    && cp /opt/librealsense/wrappers/python/pyrealsense2/__init__.py \
        "${VENV}/lib/python3.6/site-packages/pyrealsense2/" \
    && ldconfig \
    && rm -rf /opt/librealsense

# Dashboard dependency manifests for Docker layer caching.
WORKDIR /home/vex
RUN mkdir -p /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react
COPY JetsonWebDashboard/vexai-web-dashboard-react/package.json /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react/
COPY JetsonWebDashboard/vexai-web-dashboard-react/package-lock.json /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react/

# Node.js + dashboard deps
RUN apt-get update \
    && apt-get install -y nodejs npm \
    && apt-get clean \
    && npm install -g n \
    && n 16 \
    && hash -r \
    && npm install -g serve

# Python packages

RUN apt-key adv --fetch-keys https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
    && echo "deb https://repo.download.nvidia.com/jetson/common r32.7 main" > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && echo "deb https://repo.download.nvidia.com/jetson/t210 r32.7 main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && apt-get update

RUN apt-get install -y tensorrt python3-libnvinfer-dev python3-libnvinfer

RUN $VENV/bin/pip install --upgrade pip setuptools
RUN $VENV/bin/pip install pyserial websocket-server pycuda==2020.1 opencv-python==4.6.0.66 \
    && $VENV/bin/pip install --upgrade Pillow

RUN echo "/usr/lib/aarch64-linux-gnu/tegra" > /etc/ld.so.conf.d/nvidia-tegra.conf && ldconfig

RUN apt-get install -y \
    bridge-utils \
    nvme-cli \
    libpcre3 \
    linux-firmware \
    device-tree-compiler \
    libcurand-10-2 \
    efibootmgr \
    cpio \
    xxd \
    i2c-tools \
    gir1.2-appindicator3-0.1 \
    libevdev2 libinput10 libunwind8 libc6-arm64-cross libegl1-mesa\
    libgstreamer1.0-0 libgstreamer-plugins-bad1.0-0 libgstreamer-plugins-base1.0-0 \
    python3-tk python3-matplotlib \
    kmod

# ── Networking stack (needed in exported rootfs) ─────────────────────────────
RUN apt-get install -y --no-install-recommends \
        network-manager wpasupplicant wireless-regdb \
        iproute2 iputils-ping net-tools rfkill dnsmasq-base \
    && apt-get clean

RUN printf '[main]\nplugins=keyfile\n\n[device]\nwifi.backend=nl80211\n\n[keyfile]\nunmanaged-devices=none\n' \
    > /etc/NetworkManager/NetworkManager.conf

# ── SSH server ────────────────────────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends openssh-server \
    && apt-get clean \
    && mkdir -p /var/run/sshd \
    && ln -sf /lib/systemd/system/ssh.service \
        /etc/systemd/system/multi-user.target.wants/ssh.service

# Copy full source after dependency layers are cached.
WORKDIR /home/vex
COPY --chown=vex:vex . /home/vex/VAIC_26_27

WORKDIR /home/vex/VAIC_26_27/JetsonWebDashboard/vexai-web-dashboard-react
RUN [ -d build ] || (npm install && npm run build)

# ── Hostname ─────────────────────────────────────────────────────────────────
RUN echo 'vexai' > /etc/hostname

RUN sed -i 's/^[^#]/#&/' /etc/locale.gen \
    && sed -i -E '/en_(US|GB)/s/^#//' /etc/locale.gen \
    && locale-gen

# Wi-Fi hotspot
RUN mkdir -p /etc/NetworkManager/system-connections \
    && printf '[connection]\nid=Hotspot\ntype=wifi\nautoconnect=true\n\n[wifi]\nmode=ap\nssid=VexAI\n\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=vexrobotics\n\n[ipv4]\nmethod=shared\n\n[ipv6]\nmethod=ignore\n' \
        > /etc/NetworkManager/system-connections/VexAI-Hotspot.nmconnection \
    && chmod 600 /etc/NetworkManager/system-connections/VexAI-Hotspot.nmconnection

# ── vexai + resize systemd services ──────────────────────────────────────────
RUN apt-get install -y --no-install-recommends cloud-guest-utils && apt-get clean

COPY JetsonExample/Scripts/firstboot-resize.sh /usr/local/sbin/firstboot-resize.sh
COPY JetsonExample/Services/nano-legacy/vexai.service /etc/systemd/system/vexai.service
COPY JetsonExample/Services/firstboot-resize.service /etc/systemd/system/firstboot-resize.service
RUN chmod +x /home/vex/VAIC_26_27/JetsonExample/Scripts/run.sh \
    && chmod +x /home/vex/VAIC_26_27/JetsonExample/Scripts/service.sh \
    && chmod +x /usr/local/sbin/firstboot-resize.sh \
    && mkdir -p /etc/systemd/system/multi-user.target.wants \
    && ln -sf /etc/systemd/system/firstboot-resize.service \
        /etc/systemd/system/multi-user.target.wants/firstboot-resize.service \
    && ln -sf /etc/systemd/system/vexai.service \
        /etc/systemd/system/multi-user.target.wants/vexai.service